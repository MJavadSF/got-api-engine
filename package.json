{
  "name": "got-api-engine",
  "version": "4.0.0",
  "description": "A modular HTTP engine for Node.js and Next.js on got 16 — typed endpoints, middleware, per-host circuit breakers, caching (SWR, tags, Redis), rate limiting, bulkheads, hedging, retries with budgets, failover, 401 refresh, SSRF / credential-leak protection, metrics (Prometheus) and tracing (OpenTelemetry).",
  "type": "commonjs",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/adapters/next.d.mts",
        "default": "./dist/adapters/next.mjs"
      },
      "require": {
        "types": "./dist/adapters/next.d.cts",
        "default": "./dist/adapters/next.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/adapters/node.d.mts",
        "default": "./dist/adapters/node.mjs"
      },
      "require": {
        "types": "./dist/adapters/node.d.cts",
        "default": "./dist/adapters/node.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.mts",
        "default": "./dist/redis.mjs"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./codegen": {
      "import": {
        "types": "./dist/codegen.d.mts",
        "default": "./dist/codegen.mjs"
      },
      "require": {
        "types": "./dist/codegen.d.cts",
        "default": "./dist/codegen.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:package": "publint && attw --pack . --profile node16",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run lint:package",
    "prepublishOnly": "npm run build",
    "test:next": "node test/next-app/run.mjs --next 15"
  },
  "keywords": [
    "api",
    "auth",
    "bff",
    "bulkhead",
    "cache",
    "circuit-breaker",
    "codegen",
    "dedupe",
    "failover",
    "fetch",
    "got",
    "got-16",
    "hedging",
    "http",
    "http2",
    "logging",
    "metrics",
    "middleware",
    "nextjs",
    "observability",
    "openapi",
    "opentelemetry",
    "prometheus",
    "proxy",
    "rate-limit",
    "redis",
    "resilience",
    "retry",
    "ssrf",
    "stale-while-revalidate",
    "standard-schema",
    "token-refresh",
    "typescript",
    "validation",
    "persian",
    "iran"
  ],
  "author": {
    "name": "Mohammad Javad",
    "email": "mjavadsf72@gmail.com",
    "url": "https://github.com/MJavadSF"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJavadSF/got-api-engine.git"
  },
  "homepage": "https://github.com/MJavadSF/got-api-engine#readme",
  "bugs": {
    "url": "https://github.com/MJavadSF/got-api-engine/issues"
  },
  "peerDependencies": {
    "winston": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "winston": {
      "optional": true
    }
  },
  "dependencies": {
    "got": "^16.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "bin": {
    "got-api-engine-codegen": "./dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
