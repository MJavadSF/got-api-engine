{
  "name": "got-api-engine",
  "version": "3.0.0",
  "description": "A modular, framework-agnostic HTTP proxy engine built on got 16 — circuit breaker, response caching (SWR / stale-if-error), rate limiting, request dedupe, retries with backoff, 401 token refresh, SSRF & credential-leak protection, metrics, and first-class Next.js / Node.js support.",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/adapters/next.d.mts",
        "default": "./dist/adapters/next.mjs"
      },
      "require": {
        "types": "./dist/adapters/next.d.cts",
        "default": "./dist/adapters/next.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/adapters/node.d.mts",
        "default": "./dist/adapters/node.mjs"
      },
      "require": {
        "types": "./dist/adapters/node.d.cts",
        "default": "./dist/adapters/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "api",
    "auth",
    "cache",
    "circuit-breaker",
    "dedupe",
    "fetch",
    "got",
    "got-16",
    "http",
    "http2",
    "logging",
    "metrics",
    "middleware",
    "nextjs",
    "observability",
    "proxy",
    "rate-limit",
    "react",
    "resilience",
    "retry",
    "ssrf",
    "stale-while-revalidate",
    "token-refresh",
    "typescript",
    "typescript-7",
    "validation",
    "zod"
  ],
  "author": {
    "name": "Mohammad Javad",
    "email": "mjavadsf72@gmail.com",
    "url": "https://github.com/MJavadSF"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJavadSF/got-api-engine.git"
  },
  "homepage": "https://github.com/MJavadSF/got-api-engine#readme",
  "bugs": {
    "url": "https://github.com/MJavadSF/got-api-engine/issues"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=19.2.0",
    "winston": ">=3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "winston": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "got": "^16.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.4",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
